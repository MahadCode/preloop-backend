# Copy to .env only when you want to override the local defaults.
# Leave this file as the list of names. Do not put production secrets in Git.

# SECRET_KEY=replace-with-a-long-random-string
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:password@localhost:5432/preploop

# FRONTEND_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173

# DEFAULT_FROM_EMAIL=PrepLoop <prep@localhost>
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
